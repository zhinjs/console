{
  "name": "zhin-console-site",
  "private": true,
  "description": "Zhin Remote Console static site (Farm + GitHub Pages)",
  "type": "module",
  "scripts": {
    "dev": "farm start",
    "build": "farm build",
    "build:demo": "farm build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
