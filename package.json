{
  "name": "zhin-console-site",
  "private": true,
  "description": "Zhin Remote Console static site (Farm + GitHub Pages)",
  "type": "module",
  "scripts": {
    "dev": "farm start",
    "dev:demo": "VITE_DEMO_MODE=1 VITE_API_BASE=https://zhinjs-demo.hf.space VITE_API_TOKEN=zhin-demo farm start",
    "build": "farm build",
    "build:demo": "VITE_DEMO_MODE=1 VITE_API_BASE=https://zhinjs-demo.hf.space VITE_API_TOKEN=zhin-demo farm build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "preview": "serve dist -l 5173",
    "pages:prepare": "node scripts/prepare-github-pages.mjs"
  },
  "dependencies": {
    "@zhin.js/ai": "^1.5.6",
    "@zhin.js/client": "^2.1.11",
    "@zhin.js/contract": "^1.0.16",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@farmfe/cli": "^1.0.5",
    "@farmfe/core": "^1.7.11",
    "@farmfe/js-plugin-postcss": "^1.12.0",
    "@farmfe/plugin-react": "^1.2.6",
    "@tailwindcss/postcss": "4",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7",
    "clsx": "^2",
    "lucide-react": "^1.16.0",
    "postcss": "^8.5.14",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-refresh": "^0.18.0",
    "react-router-dom": "^7.15.1",
    "serve": "^14.2.4",
    "tailwind-merge": "^3",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.2",
    "yaml": "^2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@9.0.2"
}
